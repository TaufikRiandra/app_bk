/* Modern Premium BK System Design */
:root{
  --bg:#f8fafc;
  --bg-dark:#0f172a;
  --card:#ffffff;
  --text:#1f2937;
  --text-light:#6b7280;
  --brand:#2563eb;
  --brand-dark:#1d4ed8;
  --brand-light:#dbeafe;
  --success:#10b981;
  --danger:#ef4444;
  --warning:#f59e0b;
  --shadow-sm:0 1px 2px rgba(0,0,0,0.05);
  --shadow-md:0 4px 6px rgba(0,0,0,0.07);
  --shadow-lg:0 10px 15px rgba(0,0,0,0.1);
  --shadow-xl:0 20px 25px rgba(0,0,0,0.15);
}

*{box-sizing:border-box}

html, body{
  height:100%;
  margin:0;
  padding:0;
  font-family:'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.6;
}

/* Animations */
a, button, input, select, textarea {
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Header */
.site-header{
  background:linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
  color:#fff;
  box-shadow:var(--shadow-lg);
  position:sticky;
  top:0;
  z-index:100;
}

.site-header .container{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:1rem;
  max-width:1200px;
  margin:0 auto;
}

.brand{
  font-weight:800;
  font-size:1.375rem;
  letter-spacing:-0.5px;
}

/* Navigation */
.nav-wrap{display:flex;align-items:center;justify-content:space-between;width:100%}
.top-nav{display:flex;align-items:center;gap:0.75rem}

.nav-list{
  display:flex;
  gap:1.5rem;
  align-items:center;
  margin:0;
  padding:0;
  list-style:none;
}

.nav-list a{
  color:#fff;
  text-decoration:none;
  padding:0.625rem 0.875rem;
  font-weight:500;
  border-radius:6px;
  transition:all 0.3s ease;
}

.nav-list a:hover{
  background:rgba(255,255,255,0.15);
  transform:translateY(-2px);
}

.top-nav .btn{
  background:#fff;
  color:var(--brand);
  padding:0.625rem 1.125rem;
  border-radius:6px;
  text-decoration:none;
  font-size:0.9rem;
  font-weight:600;
  border:0;
  cursor:pointer;
  display:inline-block;
  margin-left:0.5rem;
  transition:all 0.3s ease;
  box-shadow:var(--shadow-md);
}

.top-nav .btn:hover{
  transform:translateY(-2px);
  box-shadow:var(--shadow-lg);
}

.top-nav #theme-toggle{
  background:transparent;
  border:0;
  color:#fff;
  font-size:1.25rem;
  cursor:pointer;
  padding:0.5rem;
  margin-right:0.5rem;
}

/* Container & Layout */
.container{
  max-width:1200px;
  margin:0 auto;
  padding:1rem;
}

.main-layout{
  display:grid;
  grid-template-columns:240px 1fr;
  gap:1.5rem;
  padding:1.5rem;
  max-width:1400px;
  margin:0 auto;
}

.content-area{
  padding:0.5rem 0;
}

/* Sidebar */
aside.sidebar{
  background:var(--card);
  padding:1.5rem;
  border-radius:12px;
  box-shadow:var(--shadow-md);
  height:fit-content;
  position:sticky;
  top:80px;
  border:1px solid #e5e7eb;
}

aside.sidebar ul{
  list-style:none;
  padding:0;
  margin:0;
}

aside.sidebar li{
  margin-bottom:0.4rem;
}

aside.sidebar a{
  color:var(--brand);
  text-decoration:none;
  padding:0.75rem 1rem;
  display:block;
  border-radius:8px;
  font-weight:500;
  transition:all 0.3s ease;
  border-left:3px solid transparent;
  font-size:0.95rem;
}

aside.sidebar a:hover{
  background:rgba(37,99,235,0.08);
  border-left-color:var(--brand);
  transform:translateX(4px);
  padding-left:1.25rem;
}

/* Cards */
.card{
  background:var(--card);
  padding:1.5rem;
  border-radius:12px;
  box-shadow:var(--shadow-md);
  transition:all 0.3s ease;
  border:1px solid #e5e7eb;
}

.card:hover{
  box-shadow:var(--shadow-lg);
}

/* Typography */
h1, h2, h3, h4, h5, h6{
  color:var(--text);
  margin:0 0 0.75rem 0;
  font-weight:700;
  line-height:1.3;
}

h1{font-size:2rem;letter-spacing:-0.5px}
h2{font-size:1.75rem}
h3{font-size:1.5rem}
h4{font-size:1.25rem}

p.lead{
  color:var(--text-light);
  font-size:1.1rem;
  line-height:1.8;
}

p{margin:0 0 1rem 0}

/* Forms */
form{margin:0}

label{
  display:block;
  font-size:0.95rem;
  margin-top:1.25rem;
  color:var(--text);
  font-weight:600;
  margin-bottom:0.5rem;
  text-transform:capitalize;
}

input[type="text"],
input[type="password"],
input[type="email"],
select,
textarea{
  width:100%;
  padding:0.875rem 1rem;
  border:1.5px solid #e5e7eb;
  border-radius:8px;
  font-size:1rem;
  font-family:inherit;
  transition:all 0.3s ease;
  background:var(--card);
  color:var(--text);
}

input[type="text"]:focus,
input[type="password"]:focus,
input[type="email"]:focus,
select:focus,
textarea:focus{
  outline:none;
  border-color:var(--brand);
  box-shadow:0 0 0 3px rgba(37,99,235,0.1);
  background:var(--card);
}

input[type="text"]::placeholder,
input[type="password"]::placeholder,
input[type="email"]::placeholder,
textarea::placeholder{
  color:#d1d5db;
}

/* Buttons */
button, .btn{
  background:linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  color:#fff;
  border:0;
  padding:0.875rem 1.5rem;
  border-radius:8px;
  cursor:pointer;
  font-weight:600;
  font-size:0.95rem;
  transition:all 0.3s ease;
  box-shadow:var(--shadow-md);
  display:inline-block;
  text-decoration:none;
  text-align:center;
  font-family:inherit;
}

button:hover, .btn:hover{
  transform:translateY(-3px);
  box-shadow:var(--shadow-lg);
}

button:active, .btn:active{
  transform:translateY(-1px);
}

button.secondary, .btn.secondary{
  background:#f3f4f6;
  color:var(--text);
  border:1.5px solid #e5e7eb;
  box-shadow:var(--shadow-sm);
}

button.secondary:hover, .btn.secondary:hover{
  background:#e5e7eb;
  border-color:var(--text-light);
}

button:disabled, .btn:disabled{
  opacity:0.6;
  cursor:not-allowed;
  transform:none;
}

/* Tables */
table{
  width:100%;
  border-collapse:collapse;
  margin-top:1.5rem;
  background:var(--card);
  border-radius:12px;
  overflow:hidden;
  box-shadow:var(--shadow-md);
  border:1px solid #e5e7eb;
}

table thead{
  background:linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
}

table th{
  padding:1rem 1.25rem;
  text-align:left;
  font-weight:700;
  color:var(--text);
  border-bottom:2px solid #d1d5db;
  font-size:0.95rem;
  text-transform:uppercase;
  letter-spacing:0.5px;
}

table td{
  padding:1rem 1.25rem;
  border-bottom:1px solid #f3f4f6;
  color:var(--text);
}

table tbody tr:hover{
  background:#f9fafb;
  transition:background 0.2s ease;
}

table tbody tr:last-child td{
  border-bottom:none;
}

/* Hero Section */
.hero{
  display:grid;
  grid-template-columns:1fr 420px;
  gap:3rem;
  align-items:center;
  padding:3rem 0;
  margin-bottom:2rem;
}

.hero .hero-left h1{
  font-size:2.75rem;
  margin-bottom:1rem;
  color:var(--text);
  line-height:1.1;
}

.hero .hero-left h1 span{
  background:linear-gradient(135deg, var(--brand) 0%, #1d4ed8 100%);
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
  background-clip:text;
  font-weight:800;
}

.hero .hero-left p{
  font-size:1.125rem;
  color:var(--text-light);
  line-height:1.8;
  margin-bottom:1.5rem;
}

.hero .hero-right{
  background:linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
  padding:2.5rem;
  border-radius:16px;
  box-shadow:var(--shadow-lg);
  text-align:center;
  border:1.5px solid #e5e7eb;
}

.hero .hero-right div{
  padding:1.25rem;
  border-radius:8px;
  background:rgba(37,99,235,0.04);
  margin-bottom:1rem;
}

.hero .hero-right h4{
  margin:1rem 0 0.5rem;
  color:var(--brand);
}

.hero .hero-right p{
  font-size:0.9rem;
  color:var(--text-light);
  margin:0;
}

.lead-cta{margin-top:1.5rem}

.cta{
  display:inline-block;
  background:linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  color:#fff;
  padding:1rem 2rem;
  border-radius:8px;
  text-decoration:none;
  font-weight:600;
  transition:all 0.3s ease;
  box-shadow:var(--shadow-md);
  border:0;
  cursor:pointer;
}

.cta:hover{
  transform:translateY(-3px);
  box-shadow:var(--shadow-lg);
}

/* Features */
.features{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:1.5rem;
  margin:2rem 0;
}

.feature{
  background:var(--card);
  padding:2rem;
  border-radius:12px;
  box-shadow:var(--shadow-md);
  text-align:center;
  transition:all 0.3s ease;
  border-top:4px solid var(--brand);
  border:1px solid #e5e7eb;
  border-top-color:var(--brand);
}

.feature:hover{
  transform:translateY(-8px);
  box-shadow:var(--shadow-xl);
}

.feature div{
  font-size:3.5rem;
  margin-bottom:1rem;
}

.feature h4{
  margin:1rem 0 0.5rem;
  color:var(--text);
  font-size:1.125rem;
}

.feature p{
  font-size:0.95rem;
  color:var(--text-light);
  margin:0;
}

/* Clients */
.clients{
  display:flex;
  align-items:center;
  justify-content:center;
  padding:2.5rem 0;
  gap:1.5rem;
  flex-wrap:wrap;
}

.clients .logo{
  flex:1 1 140px;
  text-align:center;
  padding:1.5rem;
  background:var(--card);
  border-radius:12px;
  border:1.5px solid #e5e7eb;
  font-weight:600;
  color:var(--text);
  transition:all 0.3s ease;
  box-shadow:var(--shadow-sm);
}

.clients .logo:hover{
  border-color:var(--brand);
  box-shadow:var(--shadow-md);
  transform:scale(1.05) translateY(-2px);
}

/* Footer */
.site-footer{
  border-top:2px solid #e5e7eb;
  padding:2rem 0;
  margin-top:3rem;
  background:var(--card);
  text-align:center;
}

.site-footer p{
  margin:0;
  color:var(--text-light);
  font-weight:500;
}

/* Messages */
.message{
  padding:1.25rem 1.5rem;
  border-radius:8px;
  margin-bottom:1.5rem;
  font-weight:500;
  border-left:4px solid;
  background-size:center;
}

.message.error{
  background:#fee2e2;
  border-left-color:var(--danger);
  color:#991b1b;
}

.message.success{
  background:#ecfdf5;
  border-left-color:var(--success);
  color:#065f46;
}

.message.warning{
  background:#fef3c7;
  border-left-color:var(--warning);
  color:#78350f;
}

/* Utility */
.mt-1{margin-top:0.5rem}
.mt-2{margin-top:1rem}
.mt-3{margin-top:1.5rem}
.mb-1{margin-bottom:0.5rem}
.mb-2{margin-bottom:1rem}

/* Responsive */
@media (max-width:1024px){
  .main-layout{
    grid-template-columns:200px 1fr;
    gap:1rem;
  }
  
  .hero{
    grid-template-columns:1fr;
    gap:2rem;
    padding:2rem 0;
  }
  
  .hero .hero-left h1{font-size:2rem}
  
  .features{grid-template-columns:repeat(2,1fr)}
}

@media (max-width:768px){
  .site-header .container{
    flex-direction:column;
    gap:1rem;
  }
  
  .nav-list{
    flex-wrap:wrap;
    gap:0.75rem;
    justify-content:center;
  }
  
  .main-layout{
    grid-template-columns:1fr;
    padding:1rem 0;
  }
  
  aside.sidebar{
    position:static;
  }
  
  .hero .hero-left h1{font-size:1.75rem}
  .hero .hero-right{display:none}
  
  .features{grid-template-columns:1fr}
  
  .clients{gap:1rem}
  .clients .logo{flex:1 1 100px;font-size:0.85rem}
}

@media (max-width:480px){
  .container{padding:0.75rem}
  
  .card{padding:1rem}
  
  table{font-size:0.85rem}
  table th, table td{padding:0.75rem}
  
  h1{font-size:1.5rem}
  h2{font-size:1.25rem}
  h3{font-size:1rem}
  
  button, .btn{
    width:100%;
    padding:0.875rem;
  }
}

/* Styles used by root index.php (Laragon landing) to keep consistent look */
.hero-container{display:flex;justify-content:center;align-items:center;height:100%;text-align:center}
.hero-card{max-width:900px;padding:3rem;background:var(--card);border-radius:12px;box-shadow:var(--shadow-lg);border:1px solid #e5e7eb}
.hero-title{font-size:48px;margin:0}
.hero-info{margin-top:20px;font-size:18px;color:var(--text-light);line-height:1.6}
.hero a{color:var(--brand);text-decoration:none;font-weight:600}
.hero a:hover{text-decoration:underline}

/* ===== MEDIASI STYLES ===== */

/* Main Container */
.mediasi-container{padding:20px;max-width:1600px;margin:0 auto}

/* Header Section */
.mediasi-header{
  background:linear-gradient(135deg, #4472C4 0%, #3a5aa0 100%);
  color:white;
  padding:20px;
  border-radius:8px;
  margin-bottom:20px;
}
.mediasi-header h2{margin:0 0 10px 0;font-size:18px}
.mediasi-header p{margin:0;font-size:13px;opacity:0.9}

/* Info Section */
.mediasi-info{
  background-color:#e7f3ff;
  padding:12px 15px;
  border-radius:8px;
  margin-bottom:20px;
  border-left:4px solid #2196F3;
}
.mediasi-info p{margin:0;font-size:13px;color:#1565c0;line-height:1.6}
.mediasi-info strong{font-weight:600}

/* Guru BK Section */
.guru-bk-section{
  background-color:#f5f5f5;
  padding:15px;
  border-radius:8px;
  margin-bottom:20px;
  border-left:4px solid #4472C4;
}
.guru-bk-label{display:block;margin-bottom:10px;font-weight:600;color:#333}
.guru-bk-select{
  flex:1;
  padding:12px;
  border:2px solid #ddd;
  border-radius:4px;
  font-size:14px;
  background-color:white;
}
.guru-bk-display{padding:10px;background-color:white;border-radius:4px;margin-top:10px}
.guru-bk-display strong{color:#666;font-size:12px}
.guru-bk-display p{margin:5px 0 0 0;font-size:14px;font-weight:500;color:#4472C4}

/* Date Section */
.date-section{
  background-color:white;
  padding:15px;
  border-radius:8px;
  margin-bottom:20px;
  border:1px solid #ddd;
}
.date-label{display:block;margin-bottom:8px;font-weight:600;color:#333}
.date-input{width:100%;padding:10px;border:1px solid #ddd;border-radius:4px;font-size:14px}

/* Table Section */
.table-section{
  background-color:white;
  border-radius:8px;
  border:1px solid #ddd;
  overflow:hidden;
}
.table-header{
  background-color:#f5f5f5;
  padding:15px;
  border-bottom:1px solid #ddd;
  display:flex;
  justify-content:space-between;
  align-items:center;
}
.table-header h3{margin:0;font-size:16px;color:#333}

/* Table */
.mediasi-table{width:100%;border-collapse:collapse;font-size:12px}
.mediasi-table thead tr{background-color:#FFC000;color:black;font-weight:600}
.mediasi-table th{padding:12px;text-align:center;border:1px solid #ddd}
.mediasi-table td{padding:12px;border:1px solid #ddd}
.mediasi-table tbody tr:hover{background-color:#f9f9f9}

/* Editable cells */
.editable-cell{cursor:pointer;padding:8px !important}
.editable-cell:hover{background-color:#fffacd}
.cell-input{width:100%;padding:4px;border:1px solid #4472C4;border-radius:3px;font-size:12px;box-sizing:border-box}
.cell-input textarea{min-height:60px;resize:vertical}

/* Action buttons */
.action-buttons{display:flex;gap:5px;justify-content:center}
.action-btn{
  padding:6px 10px;
  border:none;
  border-radius:3px;
  cursor:pointer;
  font-size:12px;
  font-weight:600;
  color:white;
  transition:all 0.3s;
}
.btn-delete{background-color:#dc3545}
.btn-delete:hover{background-color:#c82333}
.btn-save{background-color:#28a745;display:none}
.btn-cancel{background-color:#6c757d;display:none}

/* New row indicator */
.new-row{background-color:#fffacd}

/* Documentation cell */
.doc-cell{
  display:flex;
  flex-direction:column;
  gap:5px;
}
.doc-file-info{font-size:11px;color:#666}
.doc-file-error{font-size:11px;color:#dc3545}
.file-input{font-size:11px;padding:4px}

/* Footer buttons */
.mediasi-footer{padding:15px;text-align:center;border-top:1px solid #ddd}
.mediasi-btn{
  background-color:#28a745;
  color:white;
  border:none;
  padding:10px 30px;
  border-radius:4px;
  cursor:pointer;
  font-size:14px;
  font-weight:600;
  margin-right:10px;
  transition:all 0.3s;
}
.mediasi-btn:hover{background-color:#218838;opacity:0.95}
.mediasi-btn-reset{background-color:#6c757d}
.mediasi-btn-reset:hover{background-color:#5a6268}
.mediasi-btn-disabled{background-color:#c3e6cb;cursor:not-allowed}

/* Flex layout helpers */
.flex-row{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap}
.flex-col{display:flex;flex-direction:column;gap:10px}

/* Setup alert */
.setup-alert{
  background-color:#fff3cd;
  border:2px solid #ffc107;
  border-radius:4px;
  padding:15px;
  margin-bottom:20px;
}
.setup-alert p{margin:0;color:#856404;font-size:14px;line-height:1.6}
.setup-alert-title{color:#dc3545;font-weight:bold;margin-bottom:10px}
.setup-alert-error{color:#dc3545;margin:3px 0}
.setup-alert-warning{color:#856404;margin:3px 0}
.setup-alert-info{font-size:12px;color:#666;margin-top:10px}

/* Table filters */
.filter-section{
  background-color:white;
  padding:15px;
  border-radius:8px;
  margin-bottom:20px;
  border:1px solid #ddd;
}
.filter-label{font-weight:600;display:block;margin-bottom:8px;color:#333}
.filter-controls{display:flex;gap:8px;align-items:flex-start;flex-wrap:wrap}
.filter-input{padding:8px;border:1px solid #ddd;border-radius:4px;font-size:14px;flex:1;min-width:200px}
.filter-btn{
  background-color:#4472C4;
  color:white;
  border:none;
  padding:8px 16px;
  border-radius:4px;
  cursor:pointer;
  font-size:14px;
  font-weight:600;
  transition:all 0.3s;
}
.filter-btn:hover{background-color:#3a5aa0;opacity:0.95}

/* Guru BK info card */
.guru-info-card{
  background-color:#f5f5f5;
  padding:15px;
  border-left:4px solid #4472C4;
  border-radius:4px;
  margin-bottom:20px;
}
.guru-info-card p{margin:0 0 10px 0;font-size:12px;color:#666;font-weight:600}
.guru-info-card strong{font-size:14px;color:#333}

/* Report header */
.report-header{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:1rem;
  flex-wrap:wrap;
  margin-bottom:20px;
}
.report-title{margin:0;font-size:1.75rem}
.report-subtitle{color:var(--text-light);margin:0.5rem 0 1rem 0;font-size:14px}
.report-buttons{display:flex;gap:8px;flex-wrap:wrap}

/* Empty state */
.empty-state{
  padding:20px;
  text-align:center;
  color:#999;
}

/* Setup Alert Styles */
.setup-alert {
  background-color: #fff3cd;
  border: 2px solid #ffc107;
  border-radius: 4px;
  padding: 15px;
  margin-bottom: 20px;
  font-family: 'Segoe UI', Roboto, sans-serif;
}

.setup-alert-title {
  margin: 0 0 10px 0;
  color: #856404;
  font-weight: bold;
  font-size: 14px;
}

.setup-alert-label {
  margin: 5px 0;
  font-weight: 600;
  font-size: 13px;
}

.setup-alert-error-label {
  color: #dc3545;
}

.setup-alert-warning-label {
  color: #856404;
}

.setup-alert-error {
  margin: 3px 0;
  color: #dc3545;
  font-size: 12px;
}

.setup-alert-warning {
  margin: 3px 0;
  color: #856404;
  font-size: 12px;
}

.setup-alert-divider {
  margin: 10px 0;
  border: none;
  border-top: 1px solid #ffc107;
}

.setup-alert-footer {
  margin: 10px 0 0 0;
  font-size: 12px;
  color: #666;
}

.setup-alert-link {
  color: #007bff;
  text-decoration: underline;
  font-weight: 500;
  cursor: pointer;
  transition: color 0.3s;
}

.setup-alert-link:hover {
  color: #0056b3;
  text-decoration: none;
}

